                            <span class="text-gray-600 font-semibold text-xs mr-1">選擇管徑:</span>
                            <label class="inline-flex items-center gap-1 cursor-pointer"><input type="checkbox" value="φ5" class="text-indigo-600 rounded" checked onchange="updateLengthChart()"> <span class="font-medium text-purple-600">φ5</span></label>
                            <label class="inline-flex items-center gap-1 cursor-pointer"><input type="checkbox" value="φ6" class="text-indigo-600 rounded" checked onchange="updateLengthChart()"> <span class="font-medium text-blue-600">φ6</span></label>
                            <label class="inline-flex items-center gap-1 cursor-pointer"><input type="checkbox" value="φ7" class="text-indigo-600 rounded" checked onchange="updateLengthChart()"> <span class="font-medium text-amber-500">φ7</span></label>
                            <label class="inline-flex items-center gap-1 cursor-pointer"><input type="checkbox" value="φ8" class="text-indigo-600 rounded" checked onchange="updateLengthChart()"> <span class="font-medium text-red-500">φ8</span></label>

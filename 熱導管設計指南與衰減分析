    <script>
        // 原始圖表轉譯之結構化數據
        const DATA = [
            { diameter: "φ5", thickness: "0.5", width: "8", deltaT: "< 5°C", powers: ["6", "4", "", "", "", "", "", "", "", "", ""] },
            { diameter: "φ5", thickness: "1", width: "7.7", deltaT: "< 5°C", powers: ["12", "10", "", "", "", "", "", "", "", "", ""] },
            { diameter: "φ5", thickness: "1.5", width: "7.4", deltaT: "< 5°C", powers: ["25", "18", "15", "", "", "", "", "", "", "", ""] },
            { diameter: "φ5", thickness: "2", width: "7.1", deltaT: "< 3°C", powers: ["35", "27", "22", "17", "", "", "", "", "", "", ""] },
            { diameter: "φ5", thickness: "2.5", width: "6.8", deltaT: "< 3°C", powers: ["44", "29", "27", "21", "17", "", "", "", "", "", ""] },
            { diameter: "φ5", thickness: "3", width: "6.5", deltaT: "< 3°C", powers: ["53", "41", "32", "25", "20", "17", "", "", "", "", ""] },
